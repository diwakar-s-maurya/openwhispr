# KWin window rule for the dictation pill (merge into ~/.config/kwinrulesrc,
# or recreate in System Settings > Window Management > Window Rules).
# Native Wayland gives apps no way to skip the taskbar, stay on top or refuse
# focus; the original app gets these from X11 hints under XWayland.
[General]
count=1
rules=a6d7c3e2-0f5b-4c1e-9d2a-0e7b5f1c4a01

[a6d7c3e2-0f5b-4c1e-9d2a-0e7b5f1c4a01]
Description=OpenWhispr dictation pill
above=true
aboverule=2
acceptfocus=false
acceptfocusrule=2
noborder=true
noborderrule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2
skiptaskbar=true
skiptaskbarrule=2
title=Voice Recorder
titlematch=2
types=1
wmclass=local.surface.OpenWhispr
wmclassmatch=1
